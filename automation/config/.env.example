# Ostium Automation Configuration
# Copy this file to .env and fill in your values

# ===========================
# BLOCKCHAIN CONNECTION
# ===========================

# RPC endpoints (use multiple for redundancy)
RPC_URL_PRIMARY=https://your-primary-rpc-endpoint
RPC_URL_SECONDARY=https://your-backup-rpc-endpoint
RPC_URL_WEBSOCKET=wss://your-websocket-endpoint

# Chain ID (e.g., 1 for Ethereum mainnet, 42161 for Arbitrum)
CHAIN_ID=42161

# Block confirmation requirements
CONFIRMATIONS_REQUIRED=2

# ===========================
# WALLET CONFIGURATION
# ===========================

# Forwarder wallet (must be registered in upkeep contracts)
# NEVER commit this file with real keys!
FORWARDER_PRIVATE_KEY=your_private_key_here
FORWARDER_ADDRESS=0xYourForwarderAddress

# Backup forwarder (optional, for failover)
BACKUP_FORWARDER_PRIVATE_KEY=
BACKUP_FORWARDER_ADDRESS=

# ===========================
# CONTRACT ADDRESSES
# ===========================

# Ostium Core Contracts
REGISTRY_ADDRESS=0xYourRegistryAddress
TRADING_ADDRESS=0xYourTradingAddress
TRADING_STORAGE_ADDRESS=0xYourTradingStorageAddress
PAIRS_STORAGE_ADDRESS=0xYourPairsStorageAddress
PRICE_ROUTER_ADDRESS=0xYourPriceRouterAddress

# Upkeep Contracts
PRICE_UPKEEP_ADDRESS=0xYourPriceUpkeepAddress
PRIVATE_PRICE_UPKEEP_ADDRESS=0xYourPrivatePriceUpkeepAddress
TRADES_UPKEEP_ADDRESS=0xYourTradesUpkeepAddress

# Proxy Contracts (if using Safe or other proxy)
PRICE_UPKEEP_PROXY=0xYourPriceUpkeepProxyAddress
PRIVATE_PRICE_UPKEEP_PROXY=0xYourPrivatePriceUpkeepProxyAddress
TRADES_UPKEEP_PROXY=0xYourTradesUpkeepProxyAddress

# Ostium Verifier (for PrivatePriceUpkeep)
OSTIUM_VERIFIER_ADDRESS=0xYourOstiumVerifierAddress

# Chainlink Verifier Proxy (for PriceUpkeep)
CHAINLINK_VERIFIER_PROXY=0xYourChainlinkVerifierProxyAddress

# ===========================
# CHAINLINK DATA STREAMS
# ===========================

# Chainlink Data Streams API
CHAINLINK_API_URL=https://api.chain.link/data-streams
CHAINLINK_API_KEY=your_chainlink_api_key
CHAINLINK_API_SECRET=your_chainlink_api_secret

# Report refresh interval (seconds)
CHAINLINK_REFRESH_INTERVAL=10

# ===========================
# OSTIUM PRICE ORACLE
# ===========================

# Ostium private price oracle endpoint
OSTIUM_ORACLE_URL=https://your-oracle-endpoint/api/v1
OSTIUM_ORACLE_API_KEY=your_oracle_api_key

# Report signing key (if self-signing)
OSTIUM_ORACLE_SIGNING_KEY=

# ===========================
# GAS CONFIGURATION
# ===========================

# Gas price strategy: "fast" | "standard" | "slow" | "custom"
GAS_PRICE_STRATEGY=fast

# Custom gas price (only used if strategy is "custom", in Gwei)
CUSTOM_GAS_PRICE=0.5

# Maximum gas price willing to pay (Gwei)
MAX_GAS_PRICE=10

# Gas price oracle (optional, for better estimates)
GAS_ORACLE_URL=https://api.blocknative.com/gasprices/blockprices
GAS_ORACLE_API_KEY=

# Gas multiplier for priority (1.0 = no multiplier, 1.2 = 20% higher)
GAS_MULTIPLIER=1.1

# Max priority fee (Gwei, for EIP-1559)
MAX_PRIORITY_FEE=2

# ===========================
# AUTOMATION SETTINGS
# ===========================

# Enable/disable each automation
ENABLE_PRICE_UPKEEP=true
ENABLE_PRIVATE_PRICE_UPKEEP=true
ENABLE_TRADES_UPKEEP=true

# Polling intervals (seconds)
PRICE_UPKEEP_POLL_INTERVAL=10
PRIVATE_PRICE_UPKEEP_POLL_INTERVAL=10
TRADES_UPKEEP_POLL_INTERVAL=5

# Event listener start block (set to "latest" or specific block number)
START_BLOCK=latest

# Maximum blocks to scan in single query
MAX_BLOCK_RANGE=10000

# ===========================
# TRADES UPKEEP BATCHING
# ===========================

# Minimum trades to batch before executing
MIN_BATCH_SIZE=3

# Maximum trades in single batch
MAX_BATCH_SIZE=15

# Maximum wait time before forcing execution (seconds)
MAX_BATCH_WAIT_TIME=30

# Batch by trade type (separate OPEN from CLOSE for optimization)
BATCH_BY_TYPE=true

# ===========================
# EXECUTION SETTINGS
# ===========================

# Maximum retries on failure
MAX_RETRIES=3

# Retry delay (seconds)
RETRY_DELAY=5

# Transaction timeout (seconds)
TX_TIMEOUT=120

# Enable transaction simulation before sending
ENABLE_SIMULATION=true

# Revert on simulation failure
REVERT_ON_SIMULATION_FAILURE=true

# ===========================
# MONITORING & ALERTS
# ===========================

# Enable monitoring
ENABLE_MONITORING=true

# Metrics export port
METRICS_PORT=9090

# Health check port
HEALTH_CHECK_PORT=8080

# Logging level: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# Log to file
LOG_TO_FILE=true
LOG_FILE_PATH=./automation/logs/ostium-automation.log

# Log rotation (days)
LOG_ROTATION_DAYS=7

# ===========================
# ALERTING
# ===========================

# Slack webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook for alerts
DISCORD_WEBHOOK_URL=

# Email alerts (using SMTP)
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=team@yourdomain.com

# PagerDuty integration
PAGERDUTY_ENABLED=false
PAGERDUTY_INTEGRATION_KEY=

# Alert on these conditions
ALERT_ON_FAILURE=true
ALERT_ON_HIGH_GAS=true
ALERT_ON_LOW_BALANCE=true
ALERT_ON_STUCK_TX=true

# Alert thresholds
LOW_BALANCE_THRESHOLD_ETH=0.1
HIGH_GAS_THRESHOLD_GWEI=20
STUCK_TX_TIMEOUT_SECONDS=300

# ===========================
# PERFORMANCE TUNING
# ===========================

# Number of concurrent upkeep processors
CONCURRENT_PROCESSORS=3

# Maximum pending transactions
MAX_PENDING_TXS=5

# Enable mempool monitoring
MEMPOOL_MONITORING=false

# Enable MEV protection
MEV_PROTECTION=false
MEV_RELAY_URL=

# ===========================
# SAFETY FEATURES
# ===========================

# Enable circuit breaker (pauses automation on repeated failures)
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIME=300

# Enable rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Require manual approval for large transactions
REQUIRE_APPROVAL_ABOVE_GAS=1000000

# Enable dry run mode (simulate but don't execute)
DRY_RUN_MODE=false

# ===========================
# DATABASE (optional, for persistence)
# ===========================

# Database type: "sqlite" | "postgres" | "none"
DATABASE_TYPE=sqlite
DATABASE_PATH=./automation/data/ostium.db

# PostgreSQL (if using postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ostium_automation
POSTGRES_USER=
POSTGRES_PASSWORD=

# ===========================
# DEVELOPMENT/TESTING
# ===========================

# Enable test mode (uses test contracts)
TEST_MODE=false

# Test forwarder address
TEST_FORWARDER_ADDRESS=

# Verbose logging
VERBOSE=false

# Enable profiling
ENABLE_PROFILING=false
